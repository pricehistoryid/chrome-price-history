# Development: the dashboard's own API, used by `pnpm dev`.
#
# 3000 is the Vite dashboard, which proxies /api to 3001 (see
# frontend-web/apps/web/vite.config.ts). The extension talks to the API
# directly rather than through that proxy: one less hop, and it keeps working
# when the dashboard is not running.
#
# The credential is the app's INTERNAL_API_KEY, sent as a Bearer token — not a
# user session. Keep it out of this file: put it in .env.development.local,
# which git ignores.
#
# The dev host permissions in wxt.config.ts must cover this origin, or the
# background script cannot reach it.
VITE_API_URL=http://localhost:3001/api/v1/price
