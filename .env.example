# Where the environment comes from.
#
# Committed per-mode defaults:
#   .env.development   the dashboard on localhost, used by `pnpm dev`
#   .env.production    the deployed dashboard, used by `pnpm build`
#
# Local overrides, ignored by git. Highest precedence first, verified against
# this project's Vite version:
#   .env.development.local   development only  — point at another port or host
#   .env.production.local    production builds only
#   .env.local
#   .env
#
# VITE_API_URL is required, with no fallback: a development build must never
# quietly upload to production. If it is missing, uploads fail and the batches
# stay in the local retry queue until one succeeds.

# Authentication: the value the API accepts as a Bearer token.
#   production  the ingest credential, kept in .env (untracked)
#   development the local app's INTERNAL_API_KEY, kept in .env.development.local
#               (frontend-web/.env holds the current value). The local API
#               compares it literally and answers 401 "Kunci API internal
#               tidak valid" for anything else — including a production token.
VITE_API_JWT_TOKEN=your_jwt_token_here
